# --- Sachstands-Cockpit — Umgebungsvariablen ---
# In Coolify unter "Environment Variables" setzen. NICHT diese Datei mit echten
# Werten committen (echte Werte gehören in Coolify, .env ist per .gitignore ausgeschlossen).

# Betriebsmodus. false = Live (braucht PIPEDRIVE_API_TOKEN).
# Ohne Token schaltet die App automatisch in den Demo-Modus.
DEMO_MODE=false

# Port (Coolify setzt diesen i. d. R. automatisch)
PORT=3000

# --- Zugangsschutz ---
# Vorrang hat Microsoft Entra ID. Sind die vier Werte unten gesetzt, wird
# Basic-Auth nicht mehr verwendet. Anleitung: BENUTZUNG.md, Abschnitt 7.
MS_TENANT_ID=              # Verzeichnis-ID (Mandant) aus der App-Registrierung
MS_CLIENT_ID=              # Anwendungs-ID (Client)
MS_CLIENT_SECRET=          # Client-Secret (wird nur einmal angezeigt)
APP_PUBLIC_URL=https://sachstaende.gollenstede.app
ENTRA_REDIRECT_URI=        # optional; sonst <APP_PUBLIC_URL>/auth/callback
SESSION_SECRET=            # lange Zufallszeichenfolge zum Signieren der Sitzung
SESSION_STUNDEN=12         # Gültigkeit der Anmeldung
ENTRA_ERLAUBTE_NUTZER=     # optional, Komma getrennt. Leer = alle im Mandanten
COOKIE_SECURE=auto         # auto | true | false (auto erkennt HTTPS am Proxy)

# Notausgang, solange Entra nicht konfiguriert ist
BASIC_AUTH_USER=luke
BASIC_AUTH_PASS=bitte-aendern

# --- Ab hier erst für den Live-Modus (DEMO_MODE=false) nötig ---

# Pipedrive (Pflicht für den Live-Betrieb)
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=    # z. B. gollenstede (für Deal-Links im Cockpit)

# Hintergrundlauf
# Verbrauch der Pipedrive-API. Ein voller Lauf kostet rund 60-130 Aufrufe;
# das Tages-Kontingent ist begrenzt. Beide Werte gemeinsam bestimmen den
# Verbrauch: POLL_MINUTES wie oft gelaufen wird, FALL_TTL_STUNDEN wie oft ein
# einzelner Fall dabei wirklich neu geladen wird.
# Sachstände sind Tagesgeschäft — ein voller Lauf am Tag genügt (rund 110 Abrufe).
LAUF_STUNDE=7                # Uhrzeit des täglichen Laufs (Ortszeit)
TAKT_MINUTEN=15              # wie oft nur die Uhr geprüft wird (kostet nichts)
FALL_TTL_STUNDEN=8           # Fenster, in dem ein Fall unverändert übernommen wird
NACHLEUCHTEN_STUNDEN=6       # wie lange entschiedene Fälle noch in der Arbeitsliste stehen
ORG_CACHE_STUNDEN=24         # Zwischenspeicher für Kanzlei-/Versicherungsdaten
MAX_CASES_PER_RUN=40         # Obergrenze je Lauf
FETCH_CONCURRENCY=4          # parallele Pipedrive-Abrufe
ABWARTEN_TAGE=30             # Wartezeit bis zur nächsten Nachfrage (Normalfall)
GERICHT_TAGE=60              # Wartezeit bei laufendem Gerichtsverfahren

# Datenablage — in Coolify auf ein persistentes Volume legen, sonst ist die
# Freigabe-Warteschlange nach jedem Deploy leer.
DATA_DIR=/data

# Anrede
DUZEN_LISTE=Claudia Busch,Philipp Nadler,Jens Schlossmacher
OWN_MAIL_DOMAINS=gollenstede-sachverstand.de

# Benachrichtigung, wenn Freigaben anliegen (n8n-Webhook)
NOTIFY_WEBHOOK_URL=
APP_PUBLIC_URL=https://sachstaende.gollenstede.app

# Microsoft 365 / Graph — nur für den späteren Mailversand.
# Mandant, Client-ID und Secret werden mit der Anmeldung oben geteilt; für den
# Versand braucht die App-Registrierung zusätzlich die Berechtigung Mail.Send.
MS_SENDER_UPN=              # Postfach für Entwürfe und Versand, z. B. luke@gollenstede-sachverstand.de

# Tägliche Übersicht der offenen Fälle
DIGEST_STUNDE=8             # ab welcher Stunde (Ortszeit) sie verschickt wird
DIGEST_EMPFAENGER=          # leer = an MS_SENDER_UPN

# Anthropic (Entwurfserzeugung) — Key aus console.anthropic.com, NICHT das Max-Abo.
# Ohne Key arbeitet die App weiter mit dem geprüften Standardtext.
# Kosten mit Sonnet 5: ca. 1,4 ct je Entwurf. Entwürfe werden nur neu erzeugt,
# wenn sich am Fall etwas geändert hat — wiederholte Läufe kosten nichts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PREIS_INPUT_USD_PRO_MIO=2    # für die Kostenschätzung im Log
PREIS_OUTPUT_USD_PRO_MIO=10

# Obsidian-Vault (Pfad im Container/Volume, falls angebunden)
VAULT_PATH=
