# --- Sachstands-Cockpit — Umgebungsvariablen ---
# In Coolify unter "Environment Variables" setzen. NICHT diese Datei mit echten
# Werten committen (echte Werte gehören in Coolify, .env ist per .gitignore ausgeschlossen).

# Betriebsmodus. false = Live (braucht PIPEDRIVE_API_TOKEN).
# Ohne Token schaltet die App automatisch in den Demo-Modus.
DEMO_MODE=false

# Port (Coolify setzt diesen i. d. R. automatisch)
PORT=3000

# --- Zugangsschutz ---
# Vorrang hat Microsoft Entra ID. Sind die vier Werte unten gesetzt, wird
# Basic-Auth nicht mehr verwendet. Anleitung: BENUTZUNG.md, Abschnitt 7.
MS_TENANT_ID=              # Verzeichnis-ID (Mandant) aus der App-Registrierung
MS_CLIENT_ID=              # Anwendungs-ID (Client)
MS_CLIENT_SECRET=          # Client-Secret (wird nur einmal angezeigt)
APP_PUBLIC_URL=https://sachstaende.gollenstede.app
ENTRA_REDIRECT_URI=        # optional; sonst <APP_PUBLIC_URL>/auth/callback
SESSION_SECRET=            # lange Zufallszeichenfolge zum Signieren der Sitzung
SESSION_STUNDEN=12         # Gültigkeit der Anmeldung
ENTRA_ERLAUBTE_NUTZER=     # optional, Komma getrennt. Leer = alle im Mandanten
COOKIE_SECURE=auto         # auto | true | false (auto erkennt HTTPS am Proxy)

# Notausgang, solange Entra nicht konfiguriert ist
BASIC_AUTH_USER=luke
BASIC_AUTH_PASS=bitte-aendern

# --- Ab hier erst für den Live-Modus (DEMO_MODE=false) nötig ---

# Pipedrive (Pflicht für den Live-Betrieb)
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=    # z. B. gollenstede (für Deal-Links im Cockpit)

# Blindkopie-Adresse von Pipedrive ("Smart BCC" / E-Mail-Dropbox). Pipedrive
# vergibt je Vorgang eine eigene Adresse nach dem Muster
#   <konto>+deal<ID>@pipedrivemail.com
# Hier genügt ein Beispiel daraus — die Deal-Nummer setzt die App je Fall selbst
# ein, der +deal-Teil darf also fehlen oder eine beliebige Nummer tragen.
# Erst diese Adresse legt die gesendete Mail am richtigen Vorgang ab; über die
# Empfängeradresse allein ordnet Pipedrive nur der Person zu, und eine Kanzlei
# hängt an vielen Deals gleichzeitig.
PIPEDRIVE_BCC_DROPBOX=kfz-sachverstaendigenbuerogollenstede@pipedrivemail.com

# --- Datenbank -------------------------------------------------------------
# Der gesamte Bestand (Warteschlange, Nacharbeiten, Adressverzeichnis) liegt in
# einer eigenen Postgres. Grund: Coolify sichert Datenbanken, aber keine Volumes.
# Der interne Hostname einer Coolify-Standalone-Datenbank IST ihre UUID, die
# Zeichenkette gehoert deshalb in die Coolify-Env und niemals ins Repository.
# Fehlt sie, laeuft die Anwendung auf dem alten Dateispeicher unter DATA_DIR --
# ohne Sicherung und ohne Bestand ueber einen Deploy hinaus.
# Siehe DATENBANK-UMSTELLUNG.md.
DATABASE_URL=postgresql://sachstaende:PASSWORT@UUID-DER-DATENBANK:5432/sachstaende

# Nur fuer Tests: eigene Datenbank, das Schema wird vor jeder Pruefung geleert.
# TEST_DATABASE_URL=postgres://localhost:5432/sachstaende_test

# Hintergrundlauf
# Verbrauch der Pipedrive-API. Ein voller Lauf kostet rund 60-130 Aufrufe;
# das Tages-Kontingent ist begrenzt. Beide Werte gemeinsam bestimmen den
# Verbrauch: POLL_MINUTES wie oft gelaufen wird, FALL_TTL_STUNDEN wie oft ein
# einzelner Fall dabei wirklich neu geladen wird.
# Sachstände sind Tagesgeschäft — ein voller Lauf am Tag genügt (rund 110 Abrufe).
LAUF_STUNDE=7                # Uhrzeit des täglichen Laufs (Ortszeit)
TAKT_MINUTEN=15              # wie oft nur die Uhr geprüft wird (kostet nichts)
FALL_TTL_STUNDEN=8           # Fenster, in dem ein Fall unverändert übernommen wird
NACHLEUCHTEN_STUNDEN=6       # wie lange entschiedene Fälle noch unter "Zu prüfen" stehen
AUFBEWAHREN_TAGE=14          # wie lange sie danach unter "Erledigt"/"Alle" bleiben (0 = für immer)
ZEITZONE=Europe/Berlin       # Zeitzone für LAUF_STUNDE und DIGEST_STUNDE
ORG_CACHE_STUNDEN=24         # Zwischenspeicher für Kanzlei-/Versicherungsdaten
MAX_CASES_PER_RUN=40         # Obergrenze je Lauf
STUFEN_CACHE_STUNDEN=12      # Zwischenspeicher für die Phasennamen aus Pipedrive

# Welche Phasen der Pipeline überhaupt angefragt werden. Die Aufgabe
# "Sachstand anfragen" bleibt am Deal hängen, egal wohin dieser wandert -
# ohne diese Einstellung landete auch ein bezahlter Fall in der Freigabe.
# Drei Schreibweisen, Namen wie in Pipedrive (Nummern gehen auch):
#   Versendet, Teilbezahlt, Klage        nur diese Phasen (Voreinstellung)
#   nicht: Aufgenommen, In Bearbeitung   alle ausser diesen
#   alle                                 kein Filter
# Zum Nachsehen: GET /api/diagnose/stufen zeigt alle Phasen und ob sie durchkommen.
PIPEDRIVE_STUFEN=Versendet, Teilbezahlt, Klage
FETCH_CONCURRENCY=4          # parallele Pipedrive-Abrufe
ABWARTEN_TAGE=30             # Wartezeit bis zur nächsten Nachfrage (Normalfall)
GERICHT_TAGE=60              # Wartezeit bei laufendem Gerichtsverfahren

# Datenablage. Seit der Umstellung auf Postgres nur noch fuer zweierlei:
# den Import des Altbestands und den Notbetrieb ohne DATABASE_URL.
DATA_DIR=/data

# Anrede
# Vertraute Kontakte — Personen, mit denen laufend zusammengearbeitet wird.
# Sie bekommen „Guten Tag," statt „Sehr geehrte Damen und Herren,". Bewusst
# NICHT „Hallo <Vorname>,": Die Anfrage gilt einem Vorgang, nicht einer Person.
# Der frühere Name DUZEN_LISTE wird weiter gelesen, falls noch gesetzt.
VERTRAUTE_KONTAKTE=Claudia Busch,Philipp Nadler,Jens Schlossmacher
OWN_MAIL_DOMAINS=gollenstede-sachverstand.de

# Benachrichtigung, wenn Freigaben anliegen (n8n-Webhook)
NOTIFY_WEBHOOK_URL=
APP_PUBLIC_URL=https://sachstaende.gollenstede.app

# Microsoft 365 / Graph — nur für den späteren Mailversand.
# Mandant, Client-ID und Secret werden mit der Anmeldung oben geteilt; für den
# Versand braucht die App-Registrierung zusätzlich die Berechtigung Mail.Send.
MS_SENDER_UPN=              # Postfach für Versand (und für Entwürfe, wenn die Zeile darunter leer ist)

# Optional: eigenes Postfach für die Anfrage-Entwürfe. Sinnvoll, wenn die
# Entwürfe in einem FREIGEGEBENEN Postfach liegen sollen, damit mehrere Personen
# sie sehen und absenden können. Ein freigegebenes Postfach hat keine Anmeldung,
# ist mit einem Anwendungstoken aber über seine primäre SMTP-Adresse ganz normal
# erreichbar und braucht dafür keine eigene Lizenz.
# Wichtig: Wird der Zugriff über eine Exchange Application Access Policy
# eingegrenzt, muss dieses Postfach ausdrücklich mit aufgenommen werden.
# Prüfen lässt sich beides unter /api/diagnose/outlook.
MS_ENTWURF_UPN=             # leer = Entwürfe liegen in MS_SENDER_UPN

# Tägliche Übersicht der offenen Fälle
DIGEST_STUNDE=8             # ab welcher Stunde (Ortszeit) sie verschickt wird
DIGEST_EMPFAENGER=          # leer = an MS_SENDER_UPN

# Anthropic (Entwurfserzeugung) — Key aus console.anthropic.com, NICHT das Max-Abo.
# Ohne Key arbeitet die App weiter mit dem geprüften Standardtext.
# Kosten mit Sonnet 5: ca. 1,4 ct je Entwurf. Entwürfe werden nur neu erzeugt,
# wenn sich am Fall etwas geändert hat — wiederholte Läufe kosten nichts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PREIS_INPUT_USD_PRO_MIO=2    # für die Kostenschätzung im Log
PREIS_OUTPUT_USD_PRO_MIO=10

# Obsidian-Vault (Pfad im Container/Volume, falls angebunden)
VAULT_PATH=
