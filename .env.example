# --- Sachstands-Cockpit — Umgebungsvariablen ---
# In Coolify unter "Environment Variables" setzen. NICHT diese Datei mit echten
# Werten committen (echte Werte gehören in Coolify, .env ist per .gitignore ausgeschlossen).

# Betriebsmodus. false = Live (braucht PIPEDRIVE_API_TOKEN).
# Ohne Token schaltet die App automatisch in den Demo-Modus.
DEMO_MODE=false

# Port (Coolify setzt diesen i. d. R. automatisch)
PORT=3000

# Zugangsschutz (dringend empfohlen fürs öffentliche Deployment)
BASIC_AUTH_USER=luke
BASIC_AUTH_PASS=bitte-aendern

# --- Ab hier erst für den Live-Modus (DEMO_MODE=false) nötig ---

# Pipedrive (Pflicht für den Live-Betrieb)
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=    # z. B. gollenstede (für Deal-Links im Cockpit)

# Hintergrundlauf
POLL_MINUTES=30              # Abstand der automatischen Läufe
MAX_CASES_PER_RUN=40         # Obergrenze je Lauf
FETCH_CONCURRENCY=4          # parallele Pipedrive-Abrufe
ABWARTEN_TAGE=30             # Wartezeit bis zur nächsten Nachfrage (Normalfall)
GERICHT_TAGE=60              # Wartezeit bei laufendem Gerichtsverfahren

# Datenablage — in Coolify auf ein persistentes Volume legen, sonst ist die
# Freigabe-Warteschlange nach jedem Deploy leer.
DATA_DIR=/data

# Anrede
DUZEN_LISTE=Claudia Busch,Philipp Nadler,Jens Schlossmacher
OWN_MAIL_DOMAINS=gollenstede-sachverstand.de

# Benachrichtigung, wenn Freigaben anliegen (n8n-Webhook)
NOTIFY_WEBHOOK_URL=
APP_PUBLIC_URL=https://sachstaende.gollenstede.app

# Microsoft 365 / Graph (App-Registrierung im Entra-Portal)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_UPN=              # Postfach, aus dem gesendet wird, z. B. luke@gollenstede-sachverstand.de

# Anthropic (Entwurfserzeugung)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Obsidian-Vault (Pfad im Container/Volume, falls angebunden)
VAULT_PATH=
