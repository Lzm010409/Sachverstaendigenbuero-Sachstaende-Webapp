{
  "name": "sachstands-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Cockpit zur Vorbereitung, Freigabe und Versand von Sachstandsanfragen (Kfz-Sachverständigenbüro Gollenstede)",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node starten.mjs",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "import:altbestand": "node scripts/import-altbestand.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
